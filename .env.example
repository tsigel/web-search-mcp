# Chrome запускается лениво при первом поиске или browser fallback.
WEB_SEARCH_HEADLESS=false
# WEB_SEARCH_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# WEB_SEARCH_PROFILE_DIR=/Users/you/.web-search-mcp/chrome-profile
WEB_SEARCH_TIMEOUT_MS=30000
WEB_FETCH_TIMEOUT_MS=20000
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_USER_AGENT=WebSearchMCP/0.1 (+local personal research tool)
